NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/cloudconduction_payroll
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
CLIENT_ORIGIN=http://localhost:5173

# Optional portfolio-only hosted payout workflow. Keep false/omitted for normal production.
# When true, admin-only local payout creation, test status events and retries are enabled.
# This adapter never contacts a bank/payment gateway and never transfers money.
ENABLE_LOCAL_PAYOUT_TESTS=false

# Optional Gemini API key for AI Payroll Insights.
# Keep the real key only in server/.env. Never use a VITE_ prefix or commit the key.
# The integration pins requests to the free-tier gemini-3.8-flash model and does not
# use tools, search grounding, or paid-only features. Free-tier availability and quotas
# are controlled by Google; if access is denied, the app will fail safely instead of
# switching to a paid model. Keep Google Cloud billing disabled for a zero-spend setup.
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional one-time development admin provisioning (never commit real values)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters

# Optional SMTP settings used by password-reset email OTP.
# Configure all required values with your provider before using password reset.
# Gmail/Google Workspace example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# Create an App Password after enabling 2-Step Verification; do not use your normal account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-sender-address@gmail.com
# SMTP_PASS=your-16-character-app-password
# MAIL_FROM=your-sender-address@gmail.com
