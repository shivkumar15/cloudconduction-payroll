NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/cloudconduction_payroll
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
CLIENT_ORIGIN=http://localhost:5173

# Optional one-time development admin provisioning (never commit real values)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters

# Optional SMTP settings used by password-reset email OTP.
# Configure all required values with your provider before using password reset.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password-or-provider-key
# MAIL_FROM=no-reply@example.com
